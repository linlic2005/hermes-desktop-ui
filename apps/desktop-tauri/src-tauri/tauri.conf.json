{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Desktop UI",
  "version": "0.1.0",
  "identifier": "com.hermes.desktopui",
  "build": {
    "beforeDevCommand": "npm --workspace @hermes/desktop-ui-frontend run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --workspace @hermes/desktop-ui-frontend run build",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hermes Desktop UI",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/linlic2005/hermes-desktop-ui/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1QTgwMzhCREQxQjI2QwpSV1Jzc3RHOU9JQmFDSjlYbzhtQnRPcTlLSDBQd2duMGoxQW5SUmtpNnBwdWpaVUdQSHMwc1ZXOAo="
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "publisher": "Hermes",
    "category": "DeveloperTool",
    "shortDescription": "Desktop control client for Hermes Agent Dashboard",
    "longDescription": "Hermes Desktop UI connects to a local or LAN Gateway and controls Hermes without exposing the unauthenticated official Dashboard."
  }
}
