# Hermes UI Gateway 后端配置
HERMES_UI_MODE=local
# local | remote-server

HERMES_UI_HOST=127.0.0.1
HERMES_UI_PORT=9788
HERMES_UI_TOKEN=change-me
HERMES_UI_REQUIRE_TOKEN=true

HERMES_DASHBOARD_URL=http://127.0.0.1:9119
HERMES_COMMAND=hermes
HERMES_HOME=
HERMES_PROFILE=
HERMES_WORKDIR=

LOCAL_DASHBOARD_AUTOSTART=false
LOCAL_DASHBOARD_HOST=127.0.0.1
LOCAL_DASHBOARD_PORT=9119

GATEWAY_BIND_LOCAL_ONLY=true

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,tauri://localhost

DATABASE_URL=sqlite:///./hermes_ui_gateway.db
LOG_LEVEL=INFO
PROXY_TIMEOUT_SECONDS=60
PTY_IDLE_TIMEOUT_SECONDS=1800

HERMES_TUI_COMMAND=
# 默认为空。为空时，Gateway 使用 HERMES_COMMAND + --tui。
# 测试时可设置为：python tests/fake_tui.py

PLUGIN_ROUTE_PROXY_ENABLED=true
PLUGIN_STATIC_PROXY_ENABLED=true

HERMES_ALLOW_WINDOWS_PTY_EXPERIMENTAL=false

# Hermes 前端默认配置
VITE_DEFAULT_API_BASE_URL=http://127.0.0.1:9788
VITE_DEFAULT_WS_BASE_URL=ws://127.0.0.1:9788
VITE_MOCK_API=false
